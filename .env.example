# Copy this file to .env and replace every placeholder before running RIDEX.
RIDEX_APP_NAME=RIDEX
RIDEX_APP_VERSION=0.1.0
RIDEX_ENVIRONMENT=development
RIDEX_DEBUG=true
RIDEX_API_V1_PREFIX=/api/v1
RIDEX_DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
RIDEX_SQL_ECHO=false
# Generate a long random value, for example: openssl rand -hex 32
RIDEX_JWT_SECRET_KEY=<REPLACE_WITH_A_LONG_RANDOM_SECRET>
RIDEX_JWT_ALGORITHM=HS256
RIDEX_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Pydantic expects a JSON array.
RIDEX_CORS_ORIGINS=["http://localhost:5173"]
# Email settings (console or smtp)
RIDEX_EMAIL_PROVIDER=console
RIDEX_EMAIL_HOST=smtp.example.com
RIDEX_EMAIL_PORT=587
RIDEX_EMAIL_USERNAME=username
RIDEX_EMAIL_PASSWORD=password
RIDEX_EMAIL_FROM=noreply@ridex.com
RIDEX_EMAIL_USE_TLS=true
POSTGRES_DB=<POSTGRES_DB>
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
